---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { site } from "../data/site";
import {
  canonicalUrl as buildCanonicalUrl,
  compactSchema,
  ensureTrailingSlash,
  personSchema,
  stripSchemaContext,
  webPageSchema,
  websiteSchema,
} from "../utils/seo";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
  titleSuffix?: boolean;
  canonicalUrl?: string;
  schemaType?: "WebPage" | "ProfilePage" | "AboutPage" | "CollectionPage" | "ContactPage";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = "/images/og-default.svg",
  imageAlt = `${site.shortName} website preview`,
  type = "website",
  noindex = false,
  titleSuffix = true,
  canonicalUrl,
  schemaType = "WebPage",
  structuredData,
} = Astro.props;
const pageTitle = title ? (titleSuffix ? `${title} | ${site.shortName}` : title) : `${site.name} | ${site.title}`;
const canonical = canonicalUrl ? ensureTrailingSlash(canonicalUrl) : buildCanonicalUrl(Astro.url.pathname);
const imageUrl = new URL(image, site.url);
const extraStructuredData = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData]).map(stripSchemaContext)
  : [];
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    personSchema(),
    websiteSchema(),
    webPageSchema({ canonical, title: pageTitle, description, schemaType }),
    ...extraStructuredData,
  ].map(compactSchema),
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow"} />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XRDRCV5VWZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-XRDRCV5VWZ");
    </script>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        const f = d.getElementsByTagName(s)[0];
        const j = d.createElement(s);
        const dl = l != "dataLayer" ? `&l=${l}` : "";
        j.async = true;
        j.src = `https://www.googletagmanager.com/gtm.js?id=${i}${dl}`;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-MVM293DW");
    </script>
    <!-- End Google Tag Manager -->
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("site-theme-v2");
          document.documentElement.dataset.theme = savedTheme === "dark" ? "dark" : "light";
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="p:domain_verify" content="4da6a77cba9a605b2f821a2d71bf138c" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
    <meta name="theme-color" content="#f8f5f7" />
    <link rel="alternate" type="application/rss+xml" title={`${site.shortName} RSS`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-MVM293DW"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <script is:inline>
      (() => {
        const pushAnalyticsEvent = (target) => {
          const eventName = target.dataset.analyticsEvent;
          if (!eventName) return;

          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: eventName,
            link_text: target.textContent?.trim() || target.getAttribute("aria-label") || "",
            link_url: target.href || target.getAttribute("href") || "",
            location: target.dataset.analyticsLocation || "",
          });
        };

        document.addEventListener("click", (event) => {
          const target = event.target?.closest?.("[data-analytics-event]");
          if (target) pushAnalyticsEvent(target);
        });
      })();
    </script>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
