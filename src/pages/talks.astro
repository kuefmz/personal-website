---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import { absoluteUrl, breadcrumbSchema, itemListSchema } from "../utils/seo";

const publications = await getCollection("publications");
const conferenceItems = [
  {
    title: "ISWC 2025 Conference Website",
    meta: "International Semantic Web Conference · Nara, Japan",
    text: "A public website project supporting an international semantic web research community.",
    href: "/projects/iswc-2025-website/",
  },
  ...publications
    .filter((publication) => publication.data.venue.includes("ISWC") || publication.data.venue.includes("ESWC") || publication.data.venue.includes("Scientific"))
    .map((publication) => ({
      title: publication.data.title,
      meta: publication.data.venue,
      text: publication.data.abstract,
      href: `/publications/${publication.id}/`,
    })),
  {
    title: "Google Summer of Code 2024 Project Journal",
    meta: "DBpedia · open-source project documentation",
    text: "A week-by-week public record of ontology versioning work with DBpedia.",
    href: "/projects/gsoc-2024-project-journal/",
  },
];

const structuredData = [
  breadcrumbSchema([
    { name: "Home", url: site.url },
    { name: "Talks and Conferences", url: absoluteUrl("/talks/") },
  ]),
  itemListSchema({
    name: "Conference and workshop activity",
    items: conferenceItems.map((item) => ({ name: item.title, url: absoluteUrl(item.href) })),
  }),
];
---

<BaseLayout
  title="Talks and Conferences"
  description="Conference, workshop, and public research activity by Jenifer Ciuciu-Kiss across semantic web, scientific knowledge graphs, research software, ISWC, ESWC, and DBpedia."
  schemaType="CollectionPage"
  structuredData={structuredData}
>
  <PageHero
    eyebrow="Talks and conferences"
    title="Conference, workshop, and research community activity."
    intro="Public venues and community-facing work already represented on the site, including semantic web conferences, workshop publications, and open-source research documentation."
  />

  <section class="section-compact conference-section">
    <div class="shell conference-list">
      {
        conferenceItems.map((item) => (
          <article class="conference-item">
            <p>{item.meta}</p>
            <h2><a href={item.href}>{item.title}</a></h2>
            <span>{item.text}</span>
            <a class="text-link" href={item.href}>Open related page <Icon name="arrow" size={15} /></a>
          </article>
        ))
      }
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .conference-section {
    border-top: 1px solid var(--line);
  }

  .conference-list {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .conference-item {
    display: grid;
    grid-template-columns: minmax(170px, 0.42fr) minmax(0, 0.9fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 48px);
    align-items: start;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }

  .conference-item > p {
    margin: 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .conference-item h2 {
    margin: 0;
    font-size: clamp(1.18rem, 1.9vw, 1.58rem);
    line-height: 1.18;
  }

  .conference-item h2 a {
    text-decoration: none;
  }

  .conference-item span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .conference-item .text-link {
    grid-column: 2 / -1;
    justify-self: start;
  }

  @media (max-width: 820px) {
    .conference-item {
      grid-template-columns: 1fr;
    }

    .conference-item .text-link {
      grid-column: auto;
    }
  }
</style>
