---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Icon from "../components/Icon.astro";
import PublicationItem from "../components/PublicationItem.astro";
import { researchProfiles, site } from "../data/site";
import { contentDateSortValue } from "../utils/contentDate";
import { absoluteUrl, breadcrumbSchema, itemListSchema } from "../utils/seo";

const publications = (await getCollection("publications")).sort(
  (a, b) => contentDateSortValue(b.data.date) - contentDateSortValue(a.data.date)
    || a.data.title.localeCompare(b.data.title),
);
const projects = await getCollection("projects");
const researchProjectIds = new Set([
  "research-software-classification",
  "dbpedia-ontology-time-machine",
  "knowledge-graphs",
  "rag-document-processing",
]);
const researchProjects = projects.filter((project) => researchProjectIds.has(project.id));

const topics = [
  {
    title: "Research software classification",
    text: "Machine learning and semantic alignment methods for making scientific software easier to categorize, discover, and reuse.",
    href: "/projects/research-software-classification/",
  },
  {
    title: "Scientific knowledge graphs and semantic web",
    text: "Comparative analysis of scientific knowledge graph annotations, ontology evolution, and interoperability across research metadata systems.",
    href: "/projects/knowledge-graphs/",
  },
  {
    title: "NLP, LLMs, and document intelligence",
    text: "Applied methods for extracting, validating, and retrieving information from unstructured or semi-structured documents.",
    href: "/projects/rag-document-processing/",
  },
] as const;

const structuredData = [
  breadcrumbSchema([
    { name: "Home", url: site.url },
    { name: "Research", url: absoluteUrl("/research/") },
  ]),
  itemListSchema({
    name: "Research topics",
    items: topics.map((topic) => ({ name: topic.title, url: absoluteUrl(topic.href) })),
  }),
  itemListSchema({
    name: "Research publications",
    items: publications.map((publication) => ({
      name: publication.data.title,
      url: absoluteUrl(`/publications/${publication.id}/`),
    })),
  }),
];
---

<BaseLayout
  title="Research"
  description="Research by Jenifer Ciuciu-Kiss on research software classification, scientific knowledge graphs, semantic web technologies, NLP, machine learning, and reproducible AI systems."
  schemaType="ProfilePage"
  structuredData={structuredData}
>
  <PageHero
    eyebrow="Research"
    title="Applied AI research on software, knowledge graphs, and scientific metadata."
    intro="Jenifer is completing a part-time PhD in Artificial Intelligence focused on research software classification, scientific knowledge graphs, semantic alignment, and reproducible research infrastructure."
  />

  <section class="section-compact research-intro">
    <div class="shell research-layout">
      <div>
        <p class="eyebrow">PhD focus</p>
        <h2 class="section-title">Classifying research software with machine learning and semantic knowledge.</h2>
      </div>
      <div class="research-copy">
        <p>
          The research asks how repository metadata, publication text, taxonomies, and scientific knowledge graphs can support scalable and interpretable research software classification.
        </p>
        <p>
          The practical goal is better discovery and reuse of software that supports computational science, without treating repositories as isolated code artifacts.
        </p>
        <div class="profile-links" aria-label="Research profiles">
          {researchProfiles.map((profile) => (
            <a href={profile.href} target="_blank" rel="noreferrer" data-analytics-event="research_profile_click" data-analytics-location="research">
              {profile.label} <Icon name="arrow" size={14} />
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-compact topic-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Research areas</p>
          <h2 class="section-title">Where the work connects.</h2>
        </div>
        <p class="lead">
          These topics give search engines and human readers clearer entry points into the research portfolio.
        </p>
      </div>
      <div class="topic-grid">
        {
          topics.map((topic) => (
            <article class="topic-card">
              <h3><a href={topic.href}>{topic.title}</a></h3>
              <p>{topic.text}</p>
              <a class="text-link" href={topic.href}>Open related project</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-compact publication-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Publications</p>
          <h2 class="section-title">Selected papers, thesis work, and workshop publications.</h2>
        </div>
        <p class="lead">
          The full publication index includes abstracts, PDFs or DOI links where available, BibTeX, and related project links.
        </p>
      </div>
      {publications.slice(0, 5).map((publication) => <PublicationItem {publication} compact />)}
      <div class="button-row">
        <a class="button button-primary" href="/publications/" data-analytics-event="publication_click" data-analytics-location="research">
          View all publications <Icon name="arrow" size={17} />
        </a>
        <a class="button button-quiet" href="/talks/" data-analytics-event="navigation_click" data-analytics-location="research">
          Talks and conferences
        </a>
      </div>
    </div>
  </section>

  <section class="section-compact project-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Related projects</p>
          <h2 class="section-title">Research translated into working systems.</h2>
        </div>
      </div>
      <div class="related-grid">
        {
          researchProjects.map((project) => (
            <article class="related-item">
              <p>{project.data.status}</p>
              <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
              <span>{project.data.description}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .research-intro,
  .publication-section {
    border-top: 1px solid var(--line);
  }

  .topic-section,
  .project-section {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .research-layout {
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(28px, 5vw, 68px);
  }

  .research-copy p {
    margin: 0 0 1.1em;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    margin-top: 24px;
  }

  .profile-links a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }

  .topic-grid,
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .topic-card,
  .related-item {
    padding: clamp(20px, 2.4vw, 28px);
    border: 1px solid var(--line);
    background: var(--panel);
  }

  .topic-card h3,
  .related-item h3 {
    margin: 0 0 14px;
    font-size: clamp(1.18rem, 1.8vw, 1.55rem);
    line-height: 1.16;
  }

  .topic-card h3 a,
  .related-item h3 a {
    text-decoration: none;
  }

  .topic-card p,
  .related-item span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .related-item > p {
    margin: 0 0 18px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
  }

  @media (max-width: 820px) {
    .research-layout,
    .topic-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
