---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";

const alternates = { en: "/", de: "/de/", hu: "/hu/", "x-default": "/" };
---

<BaseLayout
  lang="hu"
  title="Jenifer Ciuciu-Kiss | AI- és adatmérnök Zürichben"
  titleSuffix={false}
  description="AI- és adatmérnöki megoldások Zürichből: Python, adatfolyamatok, dokumentumautomatizálás, RAG/LLM rendszerek, tudásgráfok és backend fejlesztés."
  schemaType="ProfilePage"
  canonicalUrl="/hu/"
  {alternates}
>
  <section class="localized-hero section">
    <div class="shell localized-grid">
      <div>
        <p class="eyebrow">AI &amp; Data Engineering · Zürich</p>
        <h1 class="display">Technikai megoldások összetett adat-, automatizálási és AI-problémákra.</h1>
        <p class="lead">
          A fő területek a Python-alapú adatfolyamatok, dokumentumfeldolgozás, RAG- és LLM-alkalmazások,
          API-integrációk, tudásgráfok és megbízható backend rendszerek.
        </p>
        <div class="button-row">
          <a class="button button-primary" href="/contact/" data-analytics-event="contact_click" data-analytics-location="hu_home">
            Projekt megbeszélése <Icon name="arrow" />
          </a>
          <a class="button button-quiet" href="/projects/">Projektek</a>
          <a class="button button-quiet" href="/blog/">Technikai cikkek</a>
        </div>
      </div>
      <aside class="localized-panel">
        <p class="eyebrow">Gyakori problémák</p>
        <ul>
          <li>Manuális adat- és dokumentumfolyamatok automatizálása</li>
          <li>PDF-ek, OCR és strukturálatlan adatok megbízható feldolgozása</li>
          <li>Belső dokumentumok kereshetővé tétele RAG segítségével</li>
          <li>API-k, űrlapok, adatbázisok és üzleti rendszerek összekapcsolása</li>
          <li>Webes adatok gyűjtése, ellenőrzése és adatfolyamatokba szervezése</li>
          <li>Többnyelvű webalkalmazások technikai és SEO-struktúrájának kialakítása</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section-compact localized-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Megközelítés</p>
          <h2 class="section-title">A problémától a fenntartható rendszerig.</h2>
        </div>
        <p class="lead">
          A cél nem minél több technológia használata, hanem átlátható architektúra, követhető adatfolyamok,
          mérhető minőség és olyan megoldás, amely a prototípus után is stabilan működik.
        </p>
      </div>
      <div class="topic-grid">
        <article><h3>AI &amp; dokumentumok</h3><p>OCR, strukturált kinyerés, retrieval, RAG, kiértékelés és ellenőrizhető források.</p></article>
        <article><h3>Adatok &amp; automatizálás</h3><p>ETL/ELT, PostgreSQL, validáció, web scraping, integrációk és ismételhető workflow-k.</p></article>
        <article><h3>Szemantikus rendszerek</h3><p>Tudásgráfok, RDF, ontológiák és adatmodellezés összetett, összekapcsolt információhoz.</p></article>
      </div>
      <p class="language-note">A részletes projekt-, kutatási és blogoldalak jelenleg főként angol nyelven érhetők el.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .localized-hero { padding-block: clamp(48px, 7vw, 90px); }
  .localized-grid { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr); gap:clamp(30px,5vw,70px); align-items:start; }
  .localized-hero :global(.display) { max-width:850px; font-size:clamp(2.5rem,5vw,4.8rem); line-height:1; }
  .localized-hero .lead { max-width:720px; margin-top:24px; color:var(--muted); }
  .localized-panel { padding:28px; border:1px solid var(--line); border-radius:18px; background:var(--panel); }
  .localized-panel ul { padding-left:20px; margin:18px 0 0; color:var(--muted); }
  .localized-panel li + li { margin-top:12px; }
  .localized-section { border-top:1px solid var(--line); }
  .topic-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  .topic-grid article { padding:24px; border:1px solid var(--line); background:var(--panel); }
  .topic-grid h3 { margin:0 0 12px; }
  .topic-grid p, .language-note { color:var(--muted); }
  .language-note { margin-top:28px; font-size:.85rem; }
  @media(max-width:820px){.localized-grid,.topic-grid{grid-template-columns:1fr;}}
</style>
