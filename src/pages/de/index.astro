---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";

const alternates = { en: "/", de: "/de/", hu: "/hu/", "x-default": "/" };
---

<BaseLayout
  lang="de"
  title="Jenifer Ciuciu-Kiss | AI- & Data Engineer in Zürich"
  titleSuffix={false}
  description="AI- und Data-Engineering in Zürich: Python, Datenpipelines, Dokumentenautomatisierung, RAG/LLM-Systeme, Knowledge Graphs und technische Produktentwicklung."
  schemaType="ProfilePage"
  canonicalUrl="/de/"
  {alternates}
>
  <section class="localized-hero section">
    <div class="shell localized-grid">
      <div>
        <p class="eyebrow">AI &amp; Data Engineering · Zürich</p>
        <h1 class="display">Technische Lösungen für komplexe Daten-, Automatisierungs- und AI-Probleme.</h1>
        <p class="lead">
          Schwerpunkte sind Python-basierte Datenpipelines, Dokumentenverarbeitung, RAG- und LLM-Anwendungen,
          API-Integrationen, Knowledge Graphs und robuste Backend-Systeme.
        </p>
        <div class="button-row">
          <a class="button button-primary" href="/contact/" data-analytics-event="contact_click" data-analytics-location="de_home">
            Projekt besprechen <Icon name="arrow" />
          </a>
          <a class="button button-quiet" href="/projects/">Projekte ansehen</a>
          <a class="button button-quiet" href="/blog/">Technische Artikel</a>
        </div>
      </div>
      <aside class="localized-panel">
        <p class="eyebrow">Typische Herausforderungen</p>
        <ul>
          <li>Manuelle Daten- oder Dokumentprozesse automatisieren</li>
          <li>PDFs, OCR und unstrukturierte Daten zuverlässig verarbeiten</li>
          <li>Interne Dokumente mit RAG durchsuchbar machen</li>
          <li>APIs, Formulare, Datenbanken und Geschäftstools verbinden</li>
          <li>Webdaten sammeln, validieren und in Datenpipelines überführen</li>
          <li>Mehrsprachige Webanwendungen technisch sauber aufbauen</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section-compact localized-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Arbeitsweise</p>
          <h2 class="section-title">Vom Problem zur wartbaren Lösung.</h2>
        </div>
        <p class="lead">
          Der Fokus liegt nicht auf möglichst vielen Tools, sondern auf einer nachvollziehbaren Architektur,
          klaren Datenflüssen, messbarer Qualität und einem System, das auch nach dem ersten Prototyp stabil bleibt.
        </p>
      </div>
      <div class="topic-grid">
        <article><h3>AI &amp; Dokumente</h3><p>OCR, strukturierte Extraktion, Retrieval, RAG, Evaluation und nachvollziehbare Quellen.</p></article>
        <article><h3>Daten &amp; Automatisierung</h3><p>ETL/ELT, PostgreSQL, Validierung, Web Scraping, Integrationen und wiederholbare Workflows.</p></article>
        <article><h3>Semantische Systeme</h3><p>Knowledge Graphs, RDF, Ontologien und Datenmodelle für komplexe, verknüpfte Informationen.</p></article>
      </div>
      <p class="language-note">Detaillierte Projekt-, Forschungs- und Blogseiten sind derzeit hauptsächlich auf Englisch verfügbar.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .localized-hero { padding-block: clamp(48px, 7vw, 90px); }
  .localized-grid { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr); gap:clamp(30px,5vw,70px); align-items:start; }
  .localized-hero :global(.display) { max-width:850px; font-size:clamp(2.5rem,5vw,4.8rem); line-height:1; }
  .localized-hero .lead { max-width:720px; margin-top:24px; color:var(--muted); }
  .localized-panel { padding:28px; border:1px solid var(--line); border-radius:18px; background:var(--panel); }
  .localized-panel ul { padding-left:20px; margin:18px 0 0; color:var(--muted); }
  .localized-panel li + li { margin-top:12px; }
  .localized-section { border-top:1px solid var(--line); }
  .topic-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  .topic-grid article { padding:24px; border:1px solid var(--line); background:var(--panel); }
  .topic-grid h3 { margin:0 0 12px; }
  .topic-grid p, .language-note { color:var(--muted); }
  .language-note { margin-top:28px; font-size:.85rem; }
  @media(max-width:820px){.localized-grid,.topic-grid{grid-template-columns:1fr;}}
</style>
