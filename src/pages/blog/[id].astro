---
import { getCollection, render } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";
import { absoluteUrl, breadcrumbSchema } from "../../utils/seo";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const words = (post.body ?? "").split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(words / 220));
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const relatedPosts = allPosts
  .filter((candidate) => candidate.id !== post.id)
  .filter((candidate) => candidate.data.category === post.data.category || candidate.data.tags.some((tag) => post.data.tags.includes(tag)))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
const published = new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(post.data.publishedAt);
const canonicalUrl = absoluteUrl(`/blog/${post.id}/`);
const structuredData = [
  breadcrumbSchema([
    { name: "Home", url: site.url },
    { name: "Blog", url: absoluteUrl("/blog/") },
    { name: post.data.title, url: canonicalUrl },
  ]),
  {
    "@type": "Article",
    "@id": `${canonicalUrl}#article`,
    headline: post.data.title,
    description: post.data.description,
    author: { "@id": `${site.url}/#person` },
    publisher: { "@id": `${site.url}/#person` },
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
    keywords: post.data.tags,
    articleSection: post.data.category,
    mainEntityOfPage: `${canonicalUrl}#webpage`,
    url: canonicalUrl,
  },
];
---

<ContentLayout
  title={post.data.title}
  description={post.data.description}
  eyebrow={post.data.category}
  meta={`${published} · ${readingTime} min read`}
  type="article"
  structuredData={structuredData}
>
  {headings.length > 1 && (
    <nav class="toc" aria-label="Table of contents">
      <p>On this page</p>
      {tocHeadings.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
    </nav>
  )}
  <Content />
  {post.data.linkedin && (
    <p class="original">
      Originally shared on <a href={post.data.linkedin} target="_blank" rel="noreferrer" data-analytics-event="linkedin_click" data-analytics-location="article_detail">LinkedIn <Icon name="arrow" size={15} /></a>.
    </p>
  )}
  {
    relatedPosts.length > 0 && (
      <section class="related-posts" aria-labelledby="related-posts">
        <h2 id="related-posts">Related posts</h2>
        <ul>
          {relatedPosts.map((related) => (
            <li>
              <a href={`/blog/${related.id}/`}>{related.data.title}</a>
              <span>{related.data.category}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</ContentLayout>

<style>
  .toc {
    display: flex;
    padding: 20px 0;
    margin-bottom: 48px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    flex-direction: column;
    gap: 5px;
  }

  .toc p {
    margin: 0 0 8px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .toc a {
    color: var(--muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--accent-dark);
  }

  .original {
    padding-top: 28px;
    margin-top: 64px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .original a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .related-posts {
    padding-top: 28px;
    margin-top: 54px;
    border-top: 1px solid var(--line);
  }

  .related-posts ul {
    padding: 0;
    margin: 18px 0 0;
    list-style: none;
  }

  .related-posts li {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .related-posts span {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
  }
</style>
